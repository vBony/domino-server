PORT=3333
HOST=localhost
NODE_ENV=development

# Postgres (docker-compose local: postgres/domino/domino em localhost:5432)
DATABASE_URL="postgresql://domino:domino@localhost:5432/domino"

# Redis (presence do Colyseus - docker-compose local em localhost:6379)
REDIS_URL="redis://localhost:6379"

# Segredo usado para assinar/verificar os JWT de autenticacao
JWT_SECRET=troque-este-valor-em-producao
