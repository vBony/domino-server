generator client {
  provider = "prisma-client-js"
  output   = "../../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MatchStatus {
  waiting
  starting
  playing
  finished
}

model User {
  id           String   @id @default(uuid())
  // Sem @unique de proposito: guests (isGuest=true) nao sao identidade
  // persistente que alguem vai reusar, entao nao devem brigar por nome com
  // ninguem - nem com outro guest, nem com uma conta real. Unicidade real
  // (pra register/login) e checada na aplicacao so contra isGuest=false
  // (ver PlayerService.register/login).
  nickname     String
  passwordHash String?  @map("password_hash")
  isGuest      Boolean  @default(false) @map("is_guest")
  createdAt    DateTime @default(now()) @map("created_at")

  matchPlayers MatchPlayer[]
  ranking      Ranking?

  @@map("users")
}

model Match {
  id            String      @id @default(uuid())
  roomId        String      @unique @map("room_id")
  status        MatchStatus @default(waiting)
  winnerTeam    Int?        @map("winner_team")
  scoreTeamA    Int         @default(0) @map("score_team_a")
  scoreTeamB    Int         @default(0) @map("score_team_b")
  // Historico de jogadas (play_tile/pass_turn) como array JSON, nao mais
  // uma linha por jogada - ninguem consulta jogada individual, e uma
  // partida inteira acumulada em memoria e gravada de uma vez (junto com
  // finishMatch/abortMatch) e bem mais barato que N updates no Postgres.
  // Ver MatchService.MoveLogEntry para o formato de cada item do array.
  moves         Json        @default("[]")
  startedAt     DateTime?   @map("started_at")
  finishedAt    DateTime?   @map("finished_at")
  createdAt     DateTime    @default(now()) @map("created_at")

  players MatchPlayer[]

  @@map("matches")
}

model MatchPlayer {
  id      String @id @default(uuid())
  matchId String @map("match_id")
  userId  String @map("user_id")
  seat    Int
  team    Int
  score   Int    @default(0)

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id])

  @@unique([matchId, seat])
  @@map("match_players")
}

model Ranking {
  userId    String   @id @map("user_id")
  wins      Int      @default(0)
  losses    Int      @default(0)
  points    Int      @default(0)
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@map("rankings")
}
